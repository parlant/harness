<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>H</string>
    <key>CFBundleExecutable</key>
    <string>HApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>co.parlant.harness</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>H</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>H accesses Desktop only when you open a workspace or ask a tool to use files there.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>H accesses Documents only when you open a workspace or ask a tool to use files there.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>H accesses Downloads only when you open a workspace or ask a tool to use files there.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>H accesses network volumes for workspaces and files you choose to use.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>H accesses removable volumes for workspaces and files you choose to use.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>SUFeedURL</key>
    <string>@SPARKLE_FEED_URL@</string>
    <key>SUPublicEDKey</key>
    <string>@SPARKLE_PUBLIC_ED_KEY@</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
