<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="h-style-nonce" content={@conn.assigns[:style_nonce]} />
    <%= if (scripts = HWeb.Extensions.scripts()) != [] do %>
      <meta name="h-ext-scripts" content={Jason.encode!(Enum.map(scripts, & &1.src))} />
    <% end %>
    <title>H — Durable Agent Harness</title>
    <link rel="stylesheet" href={~p"/assets/app.css"} />
    <link :for={css <- HWeb.Extensions.stylesheets()} rel="stylesheet" href={css.href} />
    <script defer src={~p"/assets/vendor/phoenix.min.js"}>
    </script>
    <script defer src={~p"/assets/vendor/phoenix_live_view.min.js"}>
    </script>
    <script type="module" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
