<div id="inbox-shell" class="screen inbox-shell" phx-hook="InboxBrowser">
  <Layouts.app_bar title="Inbox" section={:inbox}>
    <:actions>
      <span
        :if={@counts.attention > 0}
        id="inbox-topbar-attention"
        class={[
          "badge inbox-header-count",
          if(@counts.error > 0, do: "badge-danger", else: "badge-attention")
        ]}
      >
        {@counts.attention} attention
      </span>
      <.link
        :if={@next_attention}
        id="inbox-jump-next-btn"
        navigate={InboxFilter.session_path(@next_attention.session_id, @inbox_filter)}
        class="bar-button"
        title="Jump to next session needing attention"
      >Next →</.link>
      <button
        type="button"
        class="bar-button"
        aria-haspopup="dialog"
        aria-controls="inbox-filters"
        data-open-panel="inbox-filters"
        aria-label="Inbox filters"
        title="Inbox filters"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
        <span
          :if={Map.drop(InboxFilter.params(@inbox_filter), [:filter, :subsessions]) != %{}}
          class="filter-dot"
          aria-hidden="true"
        ></span>
      </button>
    </:actions>
    <:menu_actions>
      <button id="inbox-refresh-btn" type="button" phx-click="refresh" data-dismiss-menu>Refresh Inbox</button>
    </:menu_actions>
  </Layouts.app_bar>

  <Layouts.panel id="inbox-filters" title="Filter Inbox">
    <InboxComponents.scope_controls
      id="inbox-filter"
      filter={@inbox_filter}
      options={@filter_options}
      clear_path={InboxFilter.inbox_path(%InboxFilter{})}
    />
    <button type="button" class="btn" data-close-panel>Done</button>
  </Layouts.panel>

  <main class="inbox-main" aria-label="Multi-session inbox">
    <div class="inbox-container">
      <div
        :if={@error_banner}
        id="inbox-error-banner"
        role="alert"
        class="flash-banner flash-error"
      >
        <span>{@error_banner}</span>
        <button type="button" class="btn btn-sm btn-ghost" phx-click="dismiss_error">
          Dismiss
        </button>
      </div>

      <section class="inbox-toolbar">
        <InboxComponents.filter_bar
          id="inbox-filter"
          counts={@counts}
          filter_mode={@inbox_filter.mode}
          show_subsessions={@show_subsessions?}
          toggle_subsessions_event="toggle_subsessions"
        />

        <div class="inbox-shortcuts muted" aria-hidden="true">
          <span class="mono">j/k</span>
          move · <span class="mono">n/p</span>
          next attention · <span class="mono">Enter</span>
          open
        </div>
      </section>

      <InboxComponents.workspace_tree
        id="inbox-workspace-tree"
        groups={@groups}
        inbox_filter={@inbox_filter}
        new_session_event="new_session"
        empty_message={
          if @catalog_empty? do
            "No sessions yet. Open Workspaces to start one in any folder."
          else
            "No sessions match the current filter."
          end
        }
      />
    </div>
  </main>
</div>
