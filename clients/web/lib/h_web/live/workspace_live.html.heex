<div class="screen workspace-shell">
  <Layouts.app_bar title="Workspaces" section={:workspaces}>
    <:actions>
      <.link id="workspace-inbox-link" navigate={~p"/inbox"} class="bar-button" title="Inbox">
        Inbox
        <span
          :if={@session_counts.attention > 0}
          class={[
            "badge",
            if(@session_counts.error > 0, do: "badge-danger", else: "badge-attention")
          ]}
        >{@session_counts.attention}</span>
      </.link>
      <button
        type="button"
        class="bar-button"
        aria-haspopup="dialog"
        aria-controls="workspace-sessions"
        data-open-panel="workspace-sessions"
      >Sessions</button>
    </:actions>
    <:menu_actions>
      <button
        id="refresh-sessions-btn"
        type="button"
        phx-click="refresh_sessions"
        data-dismiss-menu
      >Refresh sessions</button>
    </:menu_actions>
  </Layouts.app_bar>

  <Layouts.panel id="workspace-sessions" title="All sessions" side>
    <div id="all-sessions-list">
      <InboxComponents.workspace_tree
        id="workspace-sessions-tree"
        groups={@session_groups}
        from_inbox={false}
        compact={true}
        new_session_event="start_session"
        review_event="review_workspace"
        empty_message="No sessions yet. Select a folder and start one."
      />
    </div>
  </Layouts.panel>

  <main class="workspace-browser screen-scroll" aria-label="Workspace browser">
    <div class="workspace-content">
      <div class="panel-header">
        <h2>Workspace Browser</h2>
        <div class="env-tabs" role="tablist" aria-label="Execution environments">
          <button
            :for={env <- @environments}
            type="button"
            class={["btn btn-sm", if(env.id == @env_id, do: "btn-primary", else: "btn-ghost")]}
            phx-click="select_env"
            phx-value-env_id={env.id}
          >
            {env.label || env.id}
          </button>
        </div>
      </div>

      <div class="path-toolbar">
        <button
          id="browse-up-btn"
          type="button"
          class="btn btn-sm"
          phx-click="browse_parent"
          disabled={is_nil(@parent_path)}
        >
          Up ..
        </button>

        <form phx-submit="browse_path" class="path-form">
          <div
            id="workspace-path-dir-complete"
            class="dir-complete-wrap"
            phx-hook="DirectoryComplete"
            data-event="complete_directory"
            data-kind="directory"
            data-target-id="workspace-path-input"
          >
            <div class="dir-ghost" aria-hidden="true">
              <span class="ghost-mirror"></span><span class="ghost-suffix"></span>
            </div>
            <input
              id="workspace-path-input"
              type="text"
              name="path"
              value={@path}
              aria-label="Workspace path"
              autocomplete="off"
              spellcheck="false"
              class="input mono dir-complete-input"
            />
            <div class="completion-popup dir-completions" role="listbox" hidden></div>
          </div>
          <button type="submit" class="btn btn-sm">Go</button>
        </form>

        <form id="filter-dirs-form" phx-change="filter_dirs" class="filter-form">
          <input
            type="search"
            name="filter"
            value={@filter}
            placeholder="Filter folders…"
            aria-label="Filter folders"
            class="input"
          />
        </form>
      </div>

      <div :if={@browse_error} class="flash-banner flash-error">
        <span>{@browse_error}</span>
      </div>

      <form id="start-session-form" phx-submit="start_session" class="new-session-card">
        <input type="hidden" name="env_id" value={@env_id} />
        <div class="new-session-fields">
          <label class="field-group">
            <span class="field-label">Selected directory</span>
            <div
              id="selected-cwd-dir-complete"
              class="dir-complete-wrap"
              phx-hook="DirectoryComplete"
              data-event="complete_directory"
              data-kind="directory"
              data-target-id="selected-cwd-input"
            >
              <div class="dir-ghost" aria-hidden="true">
                <span class="ghost-mirror"></span><span class="ghost-suffix"></span>
              </div>
              <input
                id="selected-cwd-input"
                type="text"
                name="cwd"
                value={@selected_dir}
                autocomplete="off"
                spellcheck="false"
                class="input mono dir-complete-input"
                required
              />
              <div class="completion-popup dir-completions" role="listbox" hidden></div>
            </div>
          </label>

          <label class="field-group">
            <span class="field-label">Model</span>
            <select id="workspace-model-select" name="model" class="input">
              <option
                :for={model <- @models}
                value={model.id}
                selected={model.id == @selected_model}
              >
                {model.name || model.id}
              </option>
            </select>
          </label>

          <label class="field-group">
            <span class="field-label">Session ID (optional)</span>
            <input
              id="new-session-id-input"
              type="text"
              name="session_id"
              value={@new_session_id}
              placeholder="auto-generated"
              class="input mono"
            />
          </label>
        </div>

        <div class="new-session-actions">
          <button
            id="review-selected-workspace-btn"
            type="button"
            class="btn"
            phx-click="review_workspace"
            phx-value-cwd={@selected_dir}
            disabled={@browse_error != nil}
          >
            Review files
          </button>
          <button id="start-selected-session-btn" type="submit" class="btn btn-primary">
            Start New Session
          </button>
        </div>
      </form>

      <div class="section-block">
        <h3 class="section-title">Folders in <span class="mono">{@path}</span></h3>
        <p :if={filter_directories(@directories, @filter) == []} class="muted">
          No subdirectories match.
        </p>

        <ul id="directories-list" class="dir-list">
          <li :for={dir <- filter_directories(@directories, @filter)} class="dir-row">
            <div class="dir-main">
              <button
                type="button"
                class="dir-name-btn"
                phx-click="browse_dir"
                phx-value-path={dir.path}
              >
                <span class="mono">{dir.name}/</span>
              </button>

              <span :for={marker <- dir.markers} class="badge mono">{marker}</span>

              <span
                :if={dir.active_session_count > 0}
                class="badge badge-active"
                title="Active sessions"
              >
                {dir.active_session_count} active
              </span>

              <span
                :if={dir.direct_session_count > 0 or dir.subtree_session_count > 0}
                class="badge mono"
              >
                {dir.direct_session_count} direct / {dir.subtree_session_count} total
              </span>
            </div>

            <div class="dir-actions">
              <button
                type="button"
                class="btn btn-sm btn-ghost"
                phx-click="select_dir"
                phx-value-path={dir.path}
              >
                Select
              </button>
              <button
                type="button"
                class="btn btn-sm"
                phx-click="review_workspace"
                phx-value-cwd={dir.path}
              >
                Review files
              </button>
              <button
                type="button"
                class="btn btn-sm btn-primary"
                phx-click="start_session"
                phx-value-cwd={dir.path}
              >
                Start Session
              </button>
            </div>
          </li>
        </ul>
      </div>

      <div :if={@folder_sessions != []} class="section-block">
        <h3 class="section-title">Sessions in this folder</h3>
        <ul class="session-list">
          <li :for={s <- @folder_sessions} class="session-card">
            <div class="session-card-info">
              <span class="mono session-id">{s.session_id}</span>
              <span :if={s.title} class="session-title">{s.title}</span>
              <span :if={s.active} class="badge badge-active">active</span>
              <span :if={Map.get(s, :archived, false)} class="badge mono">archived</span>
            </div>
            <.link navigate={~p"/sessions/#{s.session_id}"} class="btn btn-sm">
              {if Map.get(s, :archived, false), do: "Open", else: "Resume"}
            </.link>
          </li>
        </ul>
      </div>
    </div>
  </main>
</div>
