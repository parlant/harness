<Workbench.split
  id="session"
  class={["session-shell", if(@drawer_open?, do: "drawer-open")]}
  sidebar_label="Session navigation"
  main_label="Conversation"
>
  <:sidebar>
    <div class="sidebar-top">
      <div class="sidebar-nav-links">
        <.link id="sidebar-inbox-link" navigate={~p"/inbox"} class="btn btn-sm btn-ghost">
          ← Inbox
        </.link>
        <.link navigate={~p"/"} class="btn btn-sm btn-ghost">Workspaces</.link>
      </div>
      <button
        type="button"
        class="btn btn-sm btn-ghost mobile-only"
        phx-click="toggle_drawer"
      >
        Close
      </button>
    </div>

    <div class="sidebar-section">
      <div class="section-title">Session</div>
      <div class="mono session-id-label">{@session_id}</div>
      <div :if={@session} class="muted mono session-cwd">
        {@session.env_id}: {@session.cwd}
      </div>
    </div>

    <div class="sidebar-section">
      <div class="section-title">Conversations</div>
      <ul id="branches-list" class="branch-list">
        <li :for={conv <- @conversations}>
          <.link
            patch={conversation_path(@session_id, conv.id, @from_inbox?)}
            class={[
              "branch-link mono",
              if(to_string(conv.id) == @conversation_id, do: "is-active")
            ]}
          >
            <span>#{conv.id}</span>
            <span :if={conv.parent} class="muted">
              from #{conv.parent.conversation_id}@#{conv.parent.at}
            </span>
          </.link>
        </li>
      </ul>
    </div>

    <div id="session-inbox-switcher" class="sidebar-section sidebar-inbox-section">
      <div class="sidebar-section-head">
        <span class="section-title">All Sessions (Inbox)</span>
        <span
          :if={@catalog_counts.attention > 0}
          class={[
            "badge mono",
            if(@catalog_counts.error > 0, do: "badge-danger", else: "badge-attention")
          ]}
        >
          {@catalog_counts.attention}
        </span>
      </div>

      <InboxComponents.workspace_tree
        id="session-sidebar-inbox-tree"
        groups={@catalog_groups}
        current_session_id={@session_id}
        from_inbox={true}
        compact={true}
        empty_message="No other sessions."
      />
    </div>
  </:sidebar>

  <:main>
    <header class="session-header">
      <div class="header-left">
        <button
          id="mobile-drawer-btn"
          type="button"
          class="btn btn-sm mobile-only"
          phx-click="toggle_drawer"
        >
          <span>Menu</span>
          <span
            :if={@other_attention_count > 0}
            class={[
              "badge mono",
              if(@catalog_counts.error > 0, do: "badge-danger", else: "badge-attention")
            ]}
          >
            {@other_attention_count}
          </span>
        </button>
        <.link
          id="header-inbox-link"
          navigate={~p"/inbox"}
          class={["btn btn-sm", if(@from_inbox?, do: "btn-inbox-return", else: "btn-ghost")]}
        >
          ← Inbox
        </.link>
        <span class="mono header-sid">{@session_id}</span>
        <span class="badge mono">conv #{@conversation_id}</span>
        <span :if={!is_nil(@cursor_seq)} id="hdr-seq" class="badge mono">
          seq {@cursor_seq}
        </span>
        <span :if={usage_summary(@usage)} id="hdr-usage" class="badge mono">
          {usage_summary(@usage)}
        </span>
      </div>

      <div class="header-right">
        <.link
          :if={@next_attention_session}
          id="next-attention-btn"
          navigate={~p"/sessions/#{@next_attention_session.session_id}?from=inbox"}
          class={[
            "btn btn-sm session-attention-pill",
            if(@next_attention_session.attention in ["error", "quarantined"],
              do: "is-error",
              else: "is-idle"
            )
          ]}
          title={"Jump to #{@next_attention_session.title || @next_attention_session.session_id}"}
        >
          <span :if={@other_attention_count > 0} class="mono">
            {@other_attention_count} need attention
          </span>
          <span class="attention-pill-sep" aria-hidden="true">·</span>
          <span>
            {if @next_attention_session.attention in ["error", "quarantined"],
              do: "Next error →",
              else: "Next →"}
          </span>
        </.link>
        <button
          :if={@session && @session.status != "archived" && !@run_active?}
          id="session-attention-toggle"
          type="button"
          class={[
            "btn btn-sm",
            if(Map.get(@session, :needs_attention, true),
              do: "btn-inbox-return",
              else: "btn-ghost"
            )
          ]}
          phx-click="toggle_session_attention"
          title={
            if Map.get(@session, :needs_attention, true),
              do: "Mark as not needing attention",
              else: "Mark as needing attention"
          }
        >
          {if Map.get(@session, :needs_attention, true),
            do: "Needs attention",
            else: "Mark attention"}
        </button>
        <button
          :if={@session && @session.status != "archived"}
          id="archive-session-btn"
          type="button"
          class="btn btn-sm btn-ghost"
          phx-click="archive_current_session"
          title="Archive and unload this session"
        >
          Archive
        </button>
        <button
          :if={@run_active?}
          id="stop-btn"
          type="button"
          class="btn btn-sm btn-danger"
          phx-click="abort"
        >
          Stop
        </button>
        <form action={~p"/logout"} method="post" class="inline-form">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button type="submit" class="btn btn-sm btn-ghost">Sign out</button>
        </form>
      </div>
    </header>

    <div
      :if={@error_banner}
      id="session-error-banner"
      role="alert"
      class="flash-banner flash-error"
    >
      <span>{@error_banner}</span>
      <button type="button" class="btn btn-sm btn-ghost" phx-click="dismiss_error">
        Dismiss
      </button>
    </div>

    <div id="transcript-scroll" class="transcript-scroll" phx-hook="FollowTranscript">
      <div :if={@has_more} class="load-earlier-wrap">
        <button
          id="load-earlier-btn"
          type="button"
          class="btn btn-sm"
          phx-click="load_earlier"
        >
          Load earlier
        </button>
      </div>

      <div id="entries-stream" phx-update="stream" class="entries-list">
        <article
          :for={{dom_id, entry} <- @streams.entries}
          id={dom_id}
          class={["entry-card", "entry-#{entry["kind"]}"]}
        >
          <header class="entry-header">
            <div class="entry-header-left">
              <span class="role-label">{entry["kind"]}</span>
              <span class="badge mono">#{entry["id"]}</span>
              <span :if={entry["data"]["aborted"]} class="badge badge-warn">aborted</span>
              <span :if={entry["kind"] == "tool_result"} class="badge mono">
                {entry["data"]["tool_name"] || entry["data"]["name"] || "tool"}
              </span>
              <span
                :if={
                  entry["kind"] == "tool_result" and
                    (entry["data"]["is_error"] || entry["data"]["error"])
                }
                class="badge badge-danger"
              >
                error
              </span>
            </div>

            <button
              :if={@session && @session.status != "archived"}
              type="button"
              class="btn btn-sm btn-ghost"
              phx-click="fork_entry"
              phx-value-entry_id={entry["id"]}
            >
              Fork here
            </button>
          </header>

          <div class="entry-body">
            <ConversationComponents.entry_body entry={entry} />
          </div>
        </article>
      </div>

      <div
        :if={wait = @ephemeral_live["workspace_wait"]}
        id="workspace-wait"
        class="entry-card entry-live"
        role="status"
      >
        <p>
          Waiting for workspace held by session <span class="mono">{wait["holder_session_id"]}</span>,
          conversation #{wait["holder_conversation_id"]}.
        </p>
        <button
          id="cancel-wait-btn"
          type="button"
          class="btn btn-sm"
          phx-click="workspace_wait"
          phx-value-action="cancel"
          phx-value-task_id={wait["task_id"]}
          phx-value-lease_id={wait["lease_id"]}
        >
          Cancel wait
        </button>
        <button
          id="stop-holder-btn"
          type="button"
          class="btn btn-sm btn-danger"
          phx-click="workspace_wait"
          phx-value-action="stop_holder"
          phx-value-task_id={wait["task_id"]}
          phx-value-lease_id={wait["lease_id"]}
          data-confirm="Stop the holding conversation's active work and acquire its workspace after cleanup?"
        >
          Stop holder and acquire
        </button>
      </div>
      <ConversationComponents.live_region live={@ephemeral_live} inbox={@inbox} />
    </div>

    <button type="button" id="jump-latest" class="btn btn-sm jump-latest" hidden>Latest ↓</button>

    <div :if={@session && @session.status == "archived"} class="composer-shell">
      <div class="archive-readonly-bar">
        <span class="muted">Archived {@session.harness_id} session · read only</span>
        <button
          :if={!@show_fork_picker?}
          id="open-archive-fork-picker-btn"
          type="button"
          class="btn btn-sm"
          phx-click="open_fork_picker"
        >
          Fork into workspace…
        </button>
        <button
          :if={@show_fork_picker?}
          type="button"
          class="btn btn-sm btn-ghost"
          phx-click="close_fork_picker"
        >
          Close picker
        </button>
      </div>

      <div :if={@show_fork_picker?} id="missing-cwd-picker" class="missing-cwd-picker">
        <div class="missing-cwd-header">
          <h3 class="missing-cwd-title">Fork archived session into a workspace</h3>
          <p class="muted missing-cwd-desc">
            Select an existing directory to fork this conversation into a new live session.
          </p>
        </div>

        <div class="missing-cwd-toolbar">
          <button
            id="picker-parent-btn"
            type="button"
            class="btn btn-sm"
            phx-click="picker_parent"
            disabled={is_nil(@picker_parent_path)}
          >
            ↑ Up
          </button>
          <form id="picker-go-form" phx-submit="picker_go" class="path-form">
            <input
              id="picker-path-input"
              type="text"
              name="path"
              value={@picker_path}
              aria-label="Target directory path"
              class="input mono"
            />
            <button type="submit" class="btn btn-sm">Go</button>
          </form>
        </div>

        <div :if={@picker_error} id="picker-error" class="flash-banner flash-error">
          <span>{@picker_error}</span>
        </div>

        <ul :if={@picker_dirs != []} id="picker-dir-list" class="missing-cwd-dirs">
          <li :for={dir <- @picker_dirs}>
            <button
              type="button"
              class="missing-cwd-dir-btn mono"
              phx-click="picker_browse"
              phx-value-path={dir.path}
            >
              {dir.name}/
            </button>
          </li>
        </ul>

        <div class="missing-cwd-actions">
          <button
            id="fork-to-cwd-btn"
            type="button"
            class="btn btn-primary"
            phx-click="fork_to_directory"
            phx-value-cwd={@picker_path}
            disabled={@picker_path == ""}
          >
            Continue in <span class="mono">{@picker_path}</span> →
          </button>
        </div>
      </div>
    </div>

    <div
      :if={
        @session && @session.status != "archived" &&
          (@cwd_missing? || !Map.get(@session, :cwd_exists, true))
      }
      class="composer-shell"
    >
      <div id="missing-cwd-picker" class="missing-cwd-picker">
        <div class="missing-cwd-header">
          <h3 class="missing-cwd-title">Working directory no longer exists</h3>
          <p class="muted missing-cwd-desc">
            Working directory <span class="mono">{@session.cwd}</span>
            no longer exists. New work is paused in this session. Select an existing directory to fork and continue this conversation, or archive this session.
          </p>
        </div>

        <div class="missing-cwd-toolbar">
          <button
            id="picker-parent-btn"
            type="button"
            class="btn btn-sm"
            phx-click="picker_parent"
            disabled={is_nil(@picker_parent_path)}
          >
            ↑ Up
          </button>
          <form id="picker-go-form" phx-submit="picker_go" class="path-form">
            <input
              id="picker-path-input"
              type="text"
              name="path"
              value={@picker_path}
              aria-label="Target directory path"
              class="input mono"
            />
            <button type="submit" class="btn btn-sm">Go</button>
          </form>
        </div>

        <div :if={@picker_error} id="picker-error" class="flash-banner flash-error">
          <span>{@picker_error}</span>
        </div>

        <ul :if={@picker_dirs != []} id="picker-dir-list" class="missing-cwd-dirs">
          <li :for={dir <- @picker_dirs}>
            <button
              type="button"
              class="missing-cwd-dir-btn mono"
              phx-click="picker_browse"
              phx-value-path={dir.path}
            >
              {dir.name}/
            </button>
          </li>
        </ul>

        <div class="missing-cwd-actions">
          <button
            id="fork-to-cwd-btn"
            type="button"
            class="btn btn-primary"
            phx-click="fork_to_directory"
            phx-value-cwd={@picker_path}
            disabled={@picker_path == ""}
          >
            Continue in <span class="mono">{@picker_path}</span> →
          </button>
          <button
            id="missing-cwd-archive-btn"
            type="button"
            class="btn btn-ghost"
            phx-click="archive_current_session"
          >
            Archive session
          </button>
        </div>
      </div>
    </div>

    <div
      :if={
        @session && @session.status != "archived" && !@cwd_missing? &&
          Map.get(@session, :cwd_exists, true)
      }
      class="composer-shell"
    >
      <form id="agent-config-form" phx-change="configure" class="composer-config">
        <label class="composer-select-group">
          <span class="field-label">Model</span>
          <select id="model-select" name="model" class="input composer-select">
            <option
              :for={model <- @models}
              value={model.id}
              selected={model.id == @agent["model"]}
            >
              {model.name || model.id}
            </option>
          </select>
        </label>

        <label class="composer-select-group">
          <span class="field-label">Thinking</span>
          <select id="thinking-select" name="thinking" class="input composer-select">
            <option
              :for={level <- @thinking_levels}
              value={level}
              selected={level == (@agent["thinking"] || "medium")}
            >
              {level}
            </option>
          </select>
        </label>
      </form>

      <form
        id="composer-form"
        phx-submit="submit"
        phx-change="composer_change"
        class="composer"
      >
        <textarea
          id="prompt-input"
          name="content"
          rows="2"
          placeholder="Message the agent…"
          phx-hook="ComposerDraft"
          phx-mounted={JS.ignore_attributes("style")}
          data-session-id={@session_id}
          data-conversation-id={@conversation_id}
          class="composer-input"
        >{@composer_text}</textarea>

        <div class="composer-actions">
          <span class="composer-hint muted">Shift+Enter to send · Enter for newline</span>
          <button
            :if={@run_active?}
            id="steer-btn"
            type="button"
            class="btn btn-warn"
            phx-click="steer"
          >
            Steer
          </button>
          <button id="send-btn" type="submit" class="btn btn-primary">Send</button>
        </div>
      </form>
    </div>
  </:main>
</Workbench.split>
